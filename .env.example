# Optional path to a validated JSON inventory snapshot produced by a server connector.
# The server reads process environment variables; this example is not loaded automatically.
# Unset: uses fixtures/inventory-demo.json. No marketplace credentials are needed for demo.
# INVENTORY_SNAPSHOT_PATH=/absolute/path/to/inventory.json

# Normalized daily/weekly report ledger. No direct marketplace adapters are enabled yet.
# Import: npm run rnp:import -- /absolute/path/to/normalized-reports.json
# Set the SAME absolute path for the importer and HTTP server.
# RNP_LEDGER_PATH=/absolute/path/to/data/rnp-ledger.json

# Validated per-unit data from server adapters, not copied Excel content.
# Percentages are percentage points; a source must match the requested report period.
# Unset: /api/economics returns an empty disconnected state.
# ECONOMICS_SNAPSHOT_PATH=/absolute/path/to/economics.json
